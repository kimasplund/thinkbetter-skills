#!/usr/bin/env bash
# Block pushes that fail the spec/privacy validator or the script tests.
# CI runs the same checks, but only after a push, which is too late for a public repo.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/validate_skills.py
python3 -m unittest discover -s tests -q
